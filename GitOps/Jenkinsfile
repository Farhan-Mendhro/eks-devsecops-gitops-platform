// This job is started by the CI job, which sends it the image tag.

pipeline {
    agent any // Run on any available Jenkins machine.

    options {
        disableConcurrentBuilds() // Queue another CD run instead of running two together.
    }

    parameters {
        string(
            name: 'IMAGE_TAG', // Image version received from CI.
            defaultValue: '', // Empty when started manually.
            description: 'Image tag sent by the CI job'
        )
    }

    environment {
        GITHUB_CREDENTIALS_ID = 'github-cred' // Existing GitHub username and token credential.
        NOTIFY_EMAIL = 'farhanmendhro24@gmail.com' // Email address for pipeline results.
    }

    stages {

        // 1. Check that CI supplied an image version.
        stage('Verify Image Tag') {
            steps {
                sh 'test -n "$IMAGE_TAG"' // Stop if the image tag is empty.
                sh 'echo Deploying image tag $IMAGE_TAG' // Display the image version.
            }
        }

        // 2. Update the frontend and backend Kubernetes manifests.
        stage('Update Kubernetes Files') {
            steps {
                sh 'sed -i "/image:/s|synopsis-frontend:.*|synopsis-frontend:$IMAGE_TAG|" k8s/frontend.yml' // Update the frontend image tag.

                sh 'sed -i "/image:/s|synopsis-backend:.*|synopsis-backend:$IMAGE_TAG|" k8s/backend.yml' // Update the backend image tag.

                sh 'grep -q "synopsis-frontend:$IMAGE_TAG" k8s/frontend.yml' // Verify the frontend tag.

                sh 'grep -q "synopsis-backend:$IMAGE_TAG" k8s/backend.yml' // Verify the backend tag.
            }
        }

        // 3. Commit the updated manifests and push them to GitHub.
        stage('Git Commit and Push') {
            steps {
                sh 'git config user.name "Synopsis Jenkins"' // Set the commit author name.

                sh 'git config user.email "jenkins@users.noreply.github.com"' // Set the commit author email.

                sh 'git add k8s/frontend.yml k8s/backend.yml' // Stage only the two Kubernetes files.

                sh 'git diff --cached --quiet || git commit -m "GitOps: update Synopsis images to $IMAGE_TAG"' // Commit only when changes exist.

                withCredentials([gitUsernamePassword(credentialsId: "${GITHUB_CREDENTIALS_ID}", gitToolName: 'Default')]) {
                    sh 'git push origin HEAD:main' // Push the updated manifests to main.
                }
            }
        }
    }

    post {

        // Send an email when the CD pipeline succeeds.
        success {
            emailext(
                to: "${NOTIFY_EMAIL}",
                subject: "Synopsis CD succeeded (#${BUILD_NUMBER})",
                mimeType: 'text/html',
                attachLog: true,
                body: """
                    <html>
                    <body style="font-family:Arial,sans-serif;">
                        <h2 style="background-color:#2e7d32;color:#ffffff;padding:15px;">Synopsis CD succeeded</h2>
                        <p>The Kubernetes manifests were updated and pushed to GitHub.</p>
                        <p><b>Image tag:</b> ${IMAGE_TAG}</p>
                        <p><b>Build number:</b> ${BUILD_NUMBER}</p>
                        <p><b>Build page:</b> <a href="${BUILD_URL}">${BUILD_URL}</a></p>
                    </body>
                    </html>
                """
            )
        }

        // Send an email when the CD pipeline fails.
        failure {
            emailext(
                to: "${NOTIFY_EMAIL}",
                subject: "Synopsis CD failed (#${BUILD_NUMBER})",
                mimeType: 'text/html',
                attachLog: true,
                body: """
                    <html>
                    <body style="font-family:Arial,sans-serif;">
                        <h2 style="background-color:#d84315;color:#ffffff;padding:15px;">Synopsis CD failed</h2>
                        <p>Open the build page and attached log to identify the failed stage.</p>
                        <p><b>Image tag:</b> ${IMAGE_TAG}</p>
                        <p><b>Build number:</b> ${BUILD_NUMBER}</p>
                        <p><b>Build page:</b> <a href="${BUILD_URL}">${BUILD_URL}</a></p>
                    </body>
                    </html>
                """
            )
        }
    }
}