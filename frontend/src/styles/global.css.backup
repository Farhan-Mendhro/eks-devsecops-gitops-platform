:root{--ink:#040a18;--ink2:#0a1428;--ink3:#0f1d3a;--paper:#0a1733;--paper2:#0e1f45;--acc:#2f6bff;--acc2:#4de1ff;--ice:#a9d6ff;--tx:#e9f1ff;--mut:#8a9fc2;--mut-d:#8a9fc2;--line:rgba(143,190,255,.16);--line-d:rgba(143,190,255,.16);--ok:#34d399;--danger:#ff6b7a;
--display:'Archivo',system-ui,sans-serif;--body:'Inter',system-ui,sans-serif;--mono:'JetBrains Mono',ui-monospace,monospace}
*,*::before,*::after{box-sizing:border-box}html{scroll-behavior:smooth}
body{margin:0;background:var(--ink);color:var(--tx);font:400 16px/1.6 var(--body);-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3,h4,p,ul,ol,dl,dd{margin:0}ul,ol{padding:0;list-style:none}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit}
.wrap{width:min(1200px,100% - 48px);margin-inline:auto}.narrow{max-width:760px}
.mono{font-family:var(--mono);font-size:.74rem;letter-spacing:.12em;text-transform:uppercase}.dim{color:var(--mut)}.dim-d{color:var(--mut-d)}.ok{color:var(--ok)}.acc{color:var(--acc)}
.dark .acc,.phero .acc{color:var(--acc)}
:focus-visible{outline:2px solid var(--acc2);outline-offset:3px}
.h-xl,.h-lg,.h-md,.h-xl2{font-family:var(--display);font-stretch:125%;font-weight:800;text-transform:uppercase;letter-spacing:-.02em;line-height:.92}
.h-xl{font-size:clamp(2.4rem,6.2vw,5.8rem)}.h-xl2{font-size:clamp(2.4rem,6vw,5rem)}.h-lg{font-size:clamp(2rem,4.6vw,3.8rem)}.h-md{font-size:clamp(1.5rem,3vw,2.3rem);margin-bottom:20px}
.mask{display:block;overflow:hidden;padding-bottom:.06em}
.sub{font-size:1.2rem;color:#b7c8e6;max-width:46ch;margin:28px 0 0}.sub.dk{color:var(--mut-d)}
.tag{display:flex;align-items:center;gap:10px;color:var(--mut);margin-bottom:20px}.tag i{width:7px;height:7px;background:var(--acc)}.paper .tag{color:var(--mut-d)}.tag.top,.top{margin-top:56px}
.btn-row{display:flex;gap:20px;flex-wrap:wrap;margin-top:36px}.btn-row.top{margin-top:44px}
.link{background:none;border:0;cursor:pointer;color:var(--ice);text-decoration:underline}
/* sections */
.sec{padding:110px 0}.dark{background:var(--ink)}.paper{background:linear-gradient(180deg,#0a1733,#0c1c40);color:var(--tx)}.paper h2,.paper h3{color:#f2f8ff}
/* corner-bracket buttons */
.cbtn-wrap{position:relative;display:inline-block;padding:6px}
.cbtn-wrap::before{content:'';position:absolute;inset:0;pointer-events:none;--c:#8fb4ff;background:
linear-gradient(var(--c),var(--c)) top left/10px 1px no-repeat,linear-gradient(var(--c),var(--c)) top left/1px 10px no-repeat,
linear-gradient(var(--c),var(--c)) top right/10px 1px no-repeat,linear-gradient(var(--c),var(--c)) top right/1px 10px no-repeat,
linear-gradient(var(--c),var(--c)) bottom left/10px 1px no-repeat,linear-gradient(var(--c),var(--c)) bottom left/1px 10px no-repeat,
linear-gradient(var(--c),var(--c)) bottom right/10px 1px no-repeat,linear-gradient(var(--c),var(--c)) bottom right/1px 10px no-repeat;transition:inset .25s}
.cbtn-wrap:hover::before{inset:-3px}
.cbtn{display:inline-flex;align-items:center;gap:22px;padding:0 0 0 22px;height:48px;font:600 .78rem var(--mono);letter-spacing:.1em;text-transform:uppercase;border:0;cursor:pointer;transition:background .2s,transform .2s;color:#fff}
.cbtn-solid{background:var(--acc)}.cbtn-solid:hover{background:#4d82ff}.cbtn-dark{background:#0d1a36;border:1px solid var(--line)}.cbtn-dark:hover{background:#13244a}.cbtn-ghost{background:transparent;border:1px solid var(--line-d);color:#fff}

.cbtn:disabled{opacity:.55;cursor:wait}.cbtn-arrow{display:grid;place-items:center;width:48px;height:48px;background:#fff;color:var(--ink);transition:transform .25s}.cbtn:hover .cbtn-arrow{transform:translate(2px,-2px)}
/* header */
.hdr{position:sticky;top:0;z-index:50;background:rgba(4,10,24,.88);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.hdr-in{display:flex;align-items:center;justify-content:space-between;height:78px;gap:24px}
.logo{display:flex;align-items:center;gap:10px;font:800 1.05rem var(--display);font-stretch:125%;letter-spacing:.02em}
.hdr-nav{display:flex;gap:26px}.hdr-link{display:flex;gap:7px;align-items:center;font:500 .72rem var(--mono);letter-spacing:.14em;text-transform:uppercase;color:#b7c8e6;transition:color .2s}.hdr-link b{font-weight:500}.hdr-link i{width:6px;height:6px;background:transparent}
.hdr-link.on,.hdr-link:hover{color:#fff}.hdr-link.on i{background:var(--acc)}.hdr-link:not(.on)::before{content:none}
.hdr-right{display:flex;align-items:center;gap:18px}.hdr-user{background:none;border:0;cursor:pointer;font:500 .72rem var(--mono);letter-spacing:.12em;color:var(--ice)}.hdr-user:hover{color:#fff}
.hdr-burger,.hdr-m{display:none}.hdr-burger{background:none;border:0;cursor:pointer}
/* page hero */
.phero{position:relative;background:radial-gradient(900px 500px at 85% 20%,rgba(47,107,255,.2),transparent 60%),linear-gradient(var(--line) 1px,transparent 1px) 0 0/72px 72px,linear-gradient(90deg,var(--line) 1px,transparent 1px) 0 0/72px 72px,var(--ink);background-blend-mode:normal;padding:64px 0 84px;overflow:hidden}
.phero-in{display:grid;grid-template-columns:1.15fr .85fr;gap:40px;align-items:center}
.crumbs{color:var(--mut);margin-bottom:34px}.crumbs b{color:#fff}.crumbs a:hover{color:#fff}.kick{color:var(--acc2);margin-bottom:20px}
.phero-aside{display:flex;flex-direction:column;align-items:center}
.slabs{width:100%;max-width:440px;overflow:visible;filter:drop-shadow(0 30px 50px rgba(47,107,255,.25))}.slab-label{fill:#fff;font:800 22px var(--display);font-stretch:125%;letter-spacing:.02em}
.stat-pair{display:flex;gap:0;margin-top:8px;width:100%;max-width:440px}.stat-pair>div{flex:1;border-left:1px solid var(--line);padding:6px 20px}.stat-pair b{display:block;font:800 2.2rem var(--display);font-stretch:112%}.stat-pair span{color:var(--mut)}
/* marquee */
.marquee{overflow:hidden;border-block:1px solid var(--line);background:var(--ink2)}.marquee-track{display:flex;width:max-content;animation:mq 40s linear infinite}.marquee:hover .marquee-track{animation-play-state:paused}
.marquee-g{display:flex;flex-shrink:0}.marquee-g li{display:flex;align-items:center;gap:14px;padding:20px 30px;font:500 .74rem var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--mut);white-space:nowrap}.marquee-g i{width:6px;height:6px;background:var(--acc)}@keyframes mq{to{transform:translateX(-50%)}}
/* service list */
.srv-list{margin-top:40px;border-top:1px solid var(--line-d)}.srv-row{display:grid;grid-template-columns:56px 1.1fr 1.5fr 190px 28px;gap:20px;align-items:center;padding:28px 10px;border-bottom:1px solid var(--line-d);transition:background .3s,padding .3s}
.srv-n{color:var(--acc)}.srv-t{font:800 1.5rem var(--display);font-stretch:118%;text-transform:uppercase;color:#fff;letter-spacing:-.01em;line-height:1}.srv-b{color:#9fb3d4}
.srv-s b{display:block;font:800 1.4rem var(--display);font-stretch:112%;color:#fff}.srv-s em{font-style:normal;color:var(--mut-d)}
.srv-a{color:var(--mut-d);transition:transform .3s,color .3s}.srv-row:hover{background:linear-gradient(90deg,rgba(47,107,255,.12),transparent);padding-left:26px}.srv-row:hover .srv-a{color:var(--acc);transform:translateX(6px)}
/* journal rows */
.plist{margin-top:36px;border-top:1px solid var(--line)}.plist.light{border-top-color:var(--line-d)}
.prow{position:relative;display:grid;grid-template-columns:48px 1fr 200px 28px;gap:24px;align-items:center;padding:30px 10px;border-bottom:1px solid var(--line);transition:padding .3s,background .3s}
.light .prow{border-bottom-color:var(--line-d)}.prow-n{color:var(--acc)}.prow-main b{display:block;font:700 1.4rem/1.2 var(--display);font-stretch:108%;letter-spacing:-.01em}.light .prow-main b{color:#fff}
.prow-tags{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}.prow-tags em{font-style:normal;border:1px solid var(--line);padding:3px 9px;color:var(--ice)}.light .prow-tags em{border-color:var(--line-d);color:var(--acc)}.prow-tags.big{margin:0 0 18px}.prow-tags.big em{border-color:var(--acc2);color:var(--acc2)}
.prow-meta{color:var(--mut);line-height:1.7;text-align:right}.light .prow-meta{color:var(--mut-d)}.prow-arrow{color:var(--mut);transition:.3s}.prow:hover{padding-left:26px;background:linear-gradient(90deg,rgba(47,107,255,.14),transparent)}.prow:hover .prow-arrow{color:var(--acc2);transform:translate(4px,-4px)}
.prow-img{position:absolute;right:230px;top:50%;width:200px;height:112px;object-fit:cover;opacity:0;transform:translateY(-50%) scale(.92) rotate(-2deg);pointer-events:none;transition:.35s;border:1px solid var(--line);z-index:2}.prow:hover .prow-img{opacity:1;transform:translateY(-50%) scale(1) rotate(-2deg)}
/* stages */
.stages{position:relative;margin-top:60px}.stages-line{height:1px;background:var(--line-d);margin-bottom:0;position:relative}.stages-line span{position:absolute;inset:0;background:var(--acc);transform-origin:left;transform:scaleX(0);height:2px;top:-.5px}
.stages-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:-1px}.stage{position:relative;background:#0f2149;padding:26px 24px 30px;margin-top:34px;border-bottom:3px solid var(--line-d);transition:border-color .5s,transform .3s}.stage:hover{transform:translateY(-4px)}
.stage-dot{position:absolute;left:0;top:-42px;width:14px;height:14px;border:1px solid var(--mut-d);background:var(--paper);transition:.4s}.stage.passed{border-bottom-color:var(--acc)}.stage.passed .stage-dot{border-color:var(--acc);background:var(--acc);box-shadow:0 0 0 4px rgba(47,107,255,.2)}
.stage-top{display:flex;justify-content:space-between;color:var(--mut-d)}.stage.passed .stage-top span:last-child{color:var(--acc);display:flex;gap:5px;align-items:center}
.stage h3{font:600 1.5rem var(--body);margin:56px 0 12px;letter-spacing:-.02em;color:#fff}.stage p{color:#9fb3d4;font-size:.95rem}.stage em{display:block;margin-top:18px;font-style:normal;color:var(--mut-d);font-family:var(--mono);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase}
/* faq/terminal */
.faq{display:grid;grid-template-columns:1fr 1.1fr;gap:56px}.faq-l{margin-top:34px}.faq-l button{width:100%;display:flex;align-items:center;gap:16px;text-align:left;padding:18px 6px;background:none;border:0;border-bottom:1px solid var(--line);color:var(--mut);cursor:pointer;font-weight:600;transition:color .2s}.faq-l button svg{margin-left:auto;opacity:0;transition:.2s}.faq-l button .mono{color:var(--acc)}.faq-l button:hover,.faq-l button.on{color:#fff}.faq-l button.on svg{opacity:1;color:var(--acc2)}
.term{background:#02060f;border:1px solid var(--line);min-height:300px}.term-bar{display:flex;gap:7px;align-items:center;padding:13px 16px;border-bottom:1px solid var(--line)}.term-bar i{width:10px;height:10px;border-radius:50%;background:#1b2c4d}.term-bar span{margin-left:10px;color:var(--mut)}
.term pre{margin:0;padding:24px;white-space:pre-wrap;color:#b9cde8;line-height:1.8;font:400 .86rem/1.8 var(--mono);text-transform:none;letter-spacing:0}.caret{display:inline-block;width:8px;height:1em;background:var(--acc2);vertical-align:-2px;margin-left:3px;animation:bl 1s steps(2) infinite}@keyframes bl{50%{opacity:0}}
.pulse{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--ok);margin-right:8px;animation:pl 2s infinite}@keyframes pl{70%{box-shadow:0 0 0 8px rgba(52,211,153,0)}}
.cta{text-align:left;padding:130px 0}.paper .sub.dk{color:#9fb3d4}
/* service detail */
.two{display:grid;grid-template-columns:1.2fr 1fr;gap:70px}.body-lg{font-size:1.25rem;color:#b7c8e6;max-width:52ch}.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{padding:7px 13px;border:1px solid var(--line-d);background:transparent;color:var(--ice);cursor:default}button.chip{cursor:pointer;transition:.2s}button.chip:hover{border-color:var(--acc)}.chip.on{background:var(--acc);border-color:var(--acc);color:#fff;display:inline-flex;gap:6px;align-items:center}
.checks li{display:flex;gap:12px;padding:16px 0;border-bottom:1px solid var(--line-d);color:#fff;font-weight:500}.checks svg{color:var(--acc);flex:none;margin-top:4px}.checks.plain li{color:#b7c8e6}
.next{padding-block:10px}.link-big{display:block;margin-top:10px;transition:color .2s}.link-big:hover{color:var(--acc2)}
/* pricing */
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:10px}.plan{background:#0f2149;padding:32px 28px;display:flex;flex-direction:column;gap:6px;border-top:3px solid var(--line-d);transition:transform .3s,box-shadow .3s}.plan:hover{transform:translateY(-6px);box-shadow:0 30px 60px -30px rgba(5,11,28,.35)}
.plan.hot{background:linear-gradient(160deg,#1c4bd0,#0d2a73);color:#fff;border-top-color:var(--acc)}.plan.hot h3{color:#fff}.plan-top{display:flex;justify-content:space-between;color:var(--acc)}.plan h3{font:700 1.7rem var(--display);font-stretch:112%;margin-top:22px;text-transform:uppercase;line-height:1}.plan-p{color:#9fb3d4;min-height:48px;margin-top:8px}.plan.hot .plan-p{color:#d3e2ff}
.plan-price{margin:22px 0}.plan-price b{font:800 2.6rem var(--display);font-stretch:112%;display:block;line-height:1}.plan-price span{color:var(--mut-d)}.plan ul{margin-bottom:28px;flex:1}.plan li{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--line-d);font-size:.94rem}.plan.hot li{border-color:var(--line)}.plan li svg{color:var(--acc);margin-top:4px;flex:none}
.note{margin-top:22px;color:var(--mut-d)}.dl>div{padding:22px 0;border-bottom:1px solid var(--line-d)}.dl dt{font-weight:700;font-size:1.1rem;color:#fff}.dl dd{color:#9fb3d4;margin-top:6px;max-width:64ch}
/* about */
.facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--line-d)}.facts>div{padding:28px 20px;border-left:1px solid var(--line-d)}.facts b{display:block;font:800 clamp(1.8rem,4vw,3rem) var(--display);font-stretch:112%;color:#fff;line-height:1}.facts span{color:var(--mut-d)}
.values{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid var(--line-d)}.value{padding:34px 26px 34px 0;border-bottom:1px solid var(--line-d)}.value .mono{color:var(--acc)}.value h3{font:700 1.5rem var(--display);font-stretch:110%;margin:12px 0 8px;text-transform:uppercase}.value p{color:#9fb3d4;max-width:44ch}
/* forms */
.form{display:flex;flex-direction:column;gap:22px}.form label,.form legend{display:flex;flex-direction:column;gap:8px;font:600 .8rem var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink)}
.form input,.form textarea{width:100%;background:#fff;border:1px solid var(--line-d);border-radius:0;padding:14px 16px;font:400 1rem var(--body);color:var(--ink);letter-spacing:0;text-transform:none;transition:border-color .2s,box-shadow .2s}
.form input:focus,.form textarea:focus{outline:none;border-color:var(--acc);box-shadow:0 0 0 3px rgba(47,107,255,.18)}.form fieldset{border:0;padding:0;margin:0}.form legend{padding:0;margin-bottom:12px}
.check{flex-direction:row!important;align-items:center;gap:12px!important}.check input{width:18px;height:18px;padding:0}.inline{display:flex;gap:10px}.btn-plain{background:var(--ink);color:#fff;border:0;padding:0 18px;cursor:pointer;font:500 .72rem var(--mono);letter-spacing:.1em;text-transform:uppercase;white-space:nowrap}.cover-prev{width:100%;max-height:260px;object-fit:cover}
.form-err{padding:13px 16px;border:1px solid rgba(255,107,122,.5);background:rgba(255,107,122,.1);color:#b3192b}.alt{color:#3a4a70}.alt a{color:var(--acc);text-decoration:underline}.big-mail{display:block;font:800 clamp(1.4rem,3vw,2.2rem) var(--display);font-stretch:112%;color:var(--ink);margin:6px 0 24px}.big-mail:hover{color:var(--acc)}
/* journal */
.tabs{display:flex;gap:8px;flex-wrap:wrap}.tab{background:transparent;border:1px solid var(--line-d);padding:9px 15px;color:var(--mut-d);cursor:pointer;transition:.2s}.tab:hover{color:#fff;border-color:var(--acc2)}.tab.on{background:var(--acc);color:#fff;border-color:var(--acc)}
.demo{display:flex;gap:10px;align-items:center;padding:13px 16px;margin-bottom:22px;border:1px solid rgba(47,107,255,.4);background:rgba(47,107,255,.08);color:#a9d6ff}.empty{padding:50px 0;color:var(--mut-d)}
.post-hero{background-size:cover;background-position:center;padding:70px 0 90px}.back{background:none;border:0;cursor:pointer;color:var(--ice);display:inline-flex;gap:8px;align-items:center;margin-bottom:60px}.post-t{max-width:20ch;line-height:1}.post-meta{margin-top:24px;color:var(--mut)}
.article{max-width:760px}.article-body{white-space:pre-line;font-size:1.2rem;line-height:1.85;color:#cfdcf3}
/* overlays */
.modal-bg{position:fixed;inset:0;z-index:90;background:rgba(2,6,16,.78);backdrop-filter:blur(5px);display:grid;place-items:center;padding:20px}.modal{background:var(--paper);color:var(--tx);padding:28px;width:min(720px,100%)}.modal h3{font:800 1.3rem var(--display);font-stretch:112%;text-transform:uppercase;margin-bottom:18px}.covers{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.covers button{border:2px solid transparent;padding:0;background:none;cursor:pointer;transition:.2s}.covers button:hover{border-color:var(--acc)}.covers img{width:100%;display:block}
.toasts{position:fixed;right:20px;bottom:20px;z-index:120;display:flex;flex-direction:column;gap:10px}.toast{display:flex;gap:10px;align-items:center;padding:13px 16px;background:#0d1a36;border:1px solid var(--line);max-width:380px;font-size:.92rem;box-shadow:0 14px 40px -12px #000}.toast.ok svg{color:var(--ok)}.toast.err{border-color:rgba(255,107,122,.6)}.toast.err svg{color:var(--danger)}
.boot{position:fixed;inset:0;z-index:200;background:var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:24px}.boot ul{font:400 .85rem var(--mono);color:var(--mut);min-width:220px}.boot li{opacity:.25;transition:.2s;white-space:pre}.boot li.on{opacity:1;color:var(--ice)}.boot-bar{width:220px;height:2px;background:var(--line)}.boot-bar span{display:block;height:100%;background:linear-gradient(90deg,var(--acc),var(--acc2));transition:width .3s}
.curtain{position:fixed;inset:0;z-index:150;background:linear-gradient(135deg,#1f4fe0,#2f6bff);pointer-events:none;display:grid;place-items:center}
/* footer */
.ftr{background:var(--ink2);border-top:1px solid var(--line);padding-top:80px;overflow:hidden}.ftr-top{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr;gap:40px}.ftr h4{margin-bottom:16px;font-weight:500}.ftr-top a{display:block;padding:5px 0;color:#c4d4ee}.ftr-top a:hover{color:var(--acc2)}.ftr-mail{display:block;font:800 clamp(1.3rem,2.6vw,2rem) var(--display);font-stretch:112%;margin:10px 0 18px}
.ftr-word{font:800 clamp(4rem,17vw,15rem) var(--display);font-stretch:125%;line-height:.8;color:transparent;-webkit-text-stroke:1px rgba(143,190,255,.22);margin:70px 0 0;white-space:nowrap}.ftr-base{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;padding:22px 0 30px;border-top:1px solid var(--line)}
/* responsive */
@media (max-width:980px){.phero-in,.faq,.two{grid-template-columns:1fr}.phero-aside{order:-1;max-width:360px;margin-inline:auto}.srv-row{grid-template-columns:40px 1fr 24px}.srv-b,.srv-s{display:none}.plans{grid-template-columns:1fr}.stages-grid{grid-template-columns:1fr 1fr}.facts{grid-template-columns:1fr 1fr}.values{grid-template-columns:1fr}.ftr-top{grid-template-columns:1fr 1fr}
.prow{grid-template-columns:36px 1fr 24px}.prow-meta,.prow-img{display:none}
.hdr-burger{display:block}.hdr-cta{display:none}.hdr-nav{position:absolute;top:78px;left:0;right:0;background:var(--ink);flex-direction:column;gap:0;padding:12px 24px 22px;border-bottom:1px solid var(--line);display:none}.hdr-nav.open{display:flex}.hdr-link{padding:14px 0;border-bottom:1px solid var(--line)}.hdr-m{display:block;padding-top:14px}.hdr-user{display:none}}
@media (max-width:560px){.sec{padding:72px 0}.stages-grid{grid-template-columns:1fr}.covers{grid-template-columns:repeat(2,1fr)}.ftr-top{grid-template-columns:1fr}.inline{flex-direction:column}.btn-plain{padding:14px}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.001s!important;transition-duration:.001s!important}.marquee-track{animation:none}}

/* shared secure-cloud emblem */
.phero-aside{position:relative;display:flex;flex-direction:column;align-items:center;justify-content:center}
.sc{width:100%;max-width:470px;filter:drop-shadow(0 0 28px rgba(47,107,255,.45))}.sc-svg{width:100%;overflow:visible}
.sc-aura{transform-origin:210px 175px;animation:scAura 4s ease-in-out infinite}@keyframes scAura{50%{transform:scale(1.08);opacity:.7}}
.sc-cloud{stroke-dasharray:900;animation:scDraw 6s ease-in-out infinite}@keyframes scDraw{0%{stroke-dashoffset:900}45%,80%{stroke-dashoffset:0}100%{stroke-dashoffset:-900}}
.sc-shield{transform-origin:212px 190px;animation:scBeat 3s ease-in-out infinite}@keyframes scBeat{50%{transform:scale(1.07)}}
.sc-check{stroke-dasharray:70;animation:scCheck 3s ease-in-out infinite}@keyframes scCheck{0%{stroke-dashoffset:70}40%,85%{stroke-dashoffset:0}100%{stroke-dashoffset:-70}}
.sc-ring{fill:none;stroke:#4de1ff;stroke-width:1.5;opacity:0;transform-origin:212px 185px;animation:scRing 3s ease-out infinite}.sc-ring.r2{animation-delay:1.5s}@keyframes scRing{0%{transform:scale(1);opacity:.7}100%{transform:scale(2.7);opacity:0}}
.sc-orbit{transform-origin:212px 185px;animation:scOrbit 14s linear infinite}.sc-orbit.rev{animation-duration:20s;animation-direction:reverse}@keyframes scOrbit{to{transform:rotate(360deg)}}
.sc-circuit path{stroke-dasharray:6 6;animation:scDash 1.6s linear infinite}@keyframes scDash{to{stroke-dashoffset:-24}}
/* contact page */
.two-c{display:grid;grid-template-columns:1.25fr 1fr;gap:70px}.cform{display:flex;flex-direction:column;gap:16px}.fr2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.fbox{display:flex;flex-direction:column;gap:6px;padding:12px 14px 8px;background:#0a1530;border:1px solid var(--line);transition:border-color .2s,background .2s}.fbox:focus-within{border-color:var(--acc);background:#0c1a3a}.fbox span{color:var(--mut)}
.fbox input,.fbox select,.fbox textarea{background:none;border:0;outline:0;color:#fff;font:400 1rem var(--body);width:100%;padding:4px 0 6px;resize:vertical;box-shadow:none}.fbox select option{background:#0a1530}
.flab{color:var(--mut);margin:8px 0 -4px}.opts{display:flex;flex-wrap:wrap;gap:8px}.opt{display:inline-flex;align-items:center;gap:9px;padding:11px 14px;background:#0a1530;border:1px solid var(--line);color:#c4d4ee;cursor:pointer;transition:.2s}.opt i{width:8px;height:8px;border:1px solid var(--acc2)}.opt:hover{border-color:var(--acc2)}.opt.on{background:var(--acc);border-color:var(--acc);color:#fff}.opt.on i{background:#fff;border-color:#fff}
.cmail{display:block;font:500 clamp(1.4rem,2.6vw,2rem) var(--body);margin:10px 0 24px;padding-bottom:26px;border-bottom:1px solid var(--line)}.cmail:hover{color:var(--acc2)}
.cgrid{display:grid;grid-template-columns:1fr 1fr;gap:26px 20px;padding-bottom:26px;border-bottom:1px solid var(--line)}.cgrid p:not(.mono){margin-top:6px}.ctime{font:700 1.9rem var(--display);font-stretch:112%;line-height:1.1}
.nx{margin:26px 0 16px}.next-l li{display:grid;grid-template-columns:34px 1fr;margin-bottom:18px}.next-l .mono{color:var(--acc2)}.next-l p{color:var(--mut);font-size:.92rem}.sample{margin-top:30px;opacity:.6}
@media (max-width:980px){.two-c{grid-template-columns:1fr;gap:44px}.fr2{grid-template-columns:1fr}}
